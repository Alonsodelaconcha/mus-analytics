{
  "name": "mus-analytics-web",
  "private": true,
  "version": "0.1.0",
  "description": "Mus Analytics: calculadora de mus a 8 reyes para el móvil",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "movil": "vite --host --port 5173 --strictPort",
    "build": "npm run tipos && vite build",
    "preview": "vite preview",
    "movil-final": "npm run build && vite preview --host --port 4173 --strictPort",
    "tipos": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "verificar": "npm run tipos && npm run lint && npm test"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
